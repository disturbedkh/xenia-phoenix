{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obs_event_v1.json",
  "title": "Xenia observability event v1",
  "type": "object",
  "required": [
    "v",
    "ts_ms",
    "session",
    "origin",
    "domain",
    "channel",
    "kind",
    "severity",
    "code",
    "detail"
  ],
  "properties": {
    "v": { "const": 1 },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "session": { "type": "string" },
    "title_id": { "type": ["string", "null"] },
    "origin": { "enum": ["host", "guest"] },
    "domain": { "type": "string" },
    "channel": { "type": "string" },
    "kind": { "enum": ["Stub", "Invariant", "Event", "Log"] },
    "severity": { "enum": ["error", "warn", "info", "debug"] },
    "code": { "type": "string" },
    "detail": { "type": "string" },
    "frame": { "type": "integer", "minimum": 0 },
    "guest_lr": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
